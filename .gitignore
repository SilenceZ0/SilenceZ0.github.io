# Salida de build
/public/
/resources/
.hugo_build.lock

# Hugo escribe aquí la tabla de contenido, los índices de búsqueda y las
# estadísticas; se regeneran solos.
/hugo_stats.json

# El extractor de paletas se compila aquí
/bin/

# `go build ./...` deja el binario del extractor en la raíz del repositorio, con
# el nombre del paquete main. Está aquí para no acabarlo committeando por error.
/palette
/palette.exe

# Sistema
.DS_Store
Thumbs.db
.idea/
.vscode/
